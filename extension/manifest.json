{
  "manifest_version": 3,
  "name": "Meridian Asset Assistant",
  "version": "1.0.0",
  "description": "Automate Fixed Asset creation in MyClassboard ERP based on Lakshmi ma'am's workflow.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://meridian.myclassboard.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meridian Asset Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}

